    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FList uses the camera so you can add a photo of an item or someone on the family list."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "FList משתמש במצלמה כדי להוסיף תמונה של פריט או של מישהו ברשימת המשפחה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FList использует камеру, чтобы добавить фото товара или человека из семейного списка."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FList uses your photo library so you can add a picture of an item or someone on the family list."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "FList משתמש בגלריה כדי להוסיף תמונה של פריט או של מישהו ברשימת המשפחה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FList использует галерею, чтобы добавить фото товара или человека из семейного списка."
          }
        }
      }
    }
  },
  "version": "1.1"
