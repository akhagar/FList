    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OurStock uses the camera so you can add a photo of an item or someone on the family list, and scan an invite code."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OurStock משתמש במצלמה כדי להוסיף תמונה של פריט או של מישהו ברשימת המשפחה, ולסרוק קוד הזמנה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OurStock использует камеру, чтобы добавить фото товара или человека из семейного списка и чтобы сканировать код приглашения."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OurStock uses your photo library so you can add a picture of an item or someone on the family list."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OurStock משתמש בגלריה כדי להוסיף תמונה של פריט או של מישהו ברשימת המשפחה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OurStock использует галерею, чтобы добавить фото товара или человека из семейного списка."
          }
        }
      }
    }
  },
  "version" : "1.1"
}