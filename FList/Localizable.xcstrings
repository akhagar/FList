    "iCloud can't save this until the CloudKit schema is deployed. In CloudKit Console, open iCloud.com.tocnet.FList, then choose Deploy Schema Changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud can't save this until the CloudKit schema is deployed. In CloudKit Console, open iCloud.com.tocnet.FList, then choose Deploy Schema Changes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לשמור את זה ב-iCloud עד שפורסים את סכמת CloudKit. ב-CloudKit Console פתחו את iCloud.com.tocnet.FList ואז Deploy Schema Changes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud не сможет сохранить это, пока схема CloudKit не опубликована. В CloudKit Console откройте iCloud.com.tocnet.FList и выберите Deploy Schema Changes."
          }
        }
      }
    },
    "iCloud is restricted on this device. You can still keep a local list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is restricted on this device. You can still keep a local list."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud מוגבל במכשיר הזה. אפשר עדיין לשמור רשימה מקומית."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ограничен на этом устройстве. Можно вести локальный список."
          }
        }
      }
    },
    "If someone invited you, open the invite in Messages, or choose their shared list above. Creating a new list makes a separate list the rest of the family won't see.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If someone invited you, open the invite in Messages, or choose their shared list above. Creating a new list makes a separate list the rest of the family won't see."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם מישהו הזמין אתכם, פתחו את ההזמנה בהודעות או בחרו את הרשימה המשותפת למעלה. יצירת רשימה חדשה יוצרת רשימה נפרדת ששאר המשפחה לא תראה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вас пригласили, откройте приглашение в Сообщениях или выберите общий список выше. Новый список будет отдельным — семья его не увидит."
          }
        }
      }
    },
