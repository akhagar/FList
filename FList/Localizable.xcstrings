    "Choose what's missing. Items you already have won't stay on Needed, and the same item won't appear on both lists." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what's missing. Items you already have won't stay on Needed, and the same item won't appear on both lists."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחרו מה חסר. פריטים שיש לכם לא יישארו ברשימת החסר, ואותו פריט לא יופיע בשתי הרשימות."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте, чего не хватает. То, что уже есть, не останется в списке нужного и не появится в обоих списках."
          }
        }
      }
    },
    "Choose who gets a notification when someone adds a missing item." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose who gets a notification when someone adds a missing item."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחרו מי יקבל התראה כשמישהו מוסיף פריט חסר."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, кто получит уведомление, когда кто-то добавит недостающий товар."
          }
        }
      }
    },
