    "Sharing details" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרטי השיתוף"
          }
        }
      }
    },
    "Sign in to iCloud in Settings to invite people from your Family Sharing group. Apple doesn't let apps read that group automatically — you invite them once with Share." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחברו ל‑iCloud בהגדרות כדי להזמין אנשים מקבוצת שיתוף המשפחה. אפל לא מאפשרת לאפליקציות לקרוא את הקבוצה אוטומטית — מזמינים פעם אחת דרך שיתוף."
          }
        }
      }
    },
    "Sign in to iCloud in Settings to share this list with family." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחברו ל‑iCloud בהגדרות כדי לשתף את הרשימה עם המשפחה."
          }
        }
      }
    },
    "Something went wrong" : {
      "localizations" : {
