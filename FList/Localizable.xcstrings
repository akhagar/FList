    "Couldn't join that shared list. On Family, tap Copy invite link and paste that link here. Both phones need the same kind of build — Xcode or TestFlight.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו להצטרף לרשימה המשותפת. במשפחה, הקישו על העתקת קישור הזמנה והדביקו אותו כאן. בשני האייפונים צריך אותו סוג בנייה — Xcode או TestFlight."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't join that shared list. On Family, tap Copy invite link and paste that link here. Both phones need the same kind of build — Xcode or TestFlight."
          }
        }
      }
    },
    "Couldn't share": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
