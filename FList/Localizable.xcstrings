        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That Messages invite can't be pasted. On Family, tap Copy invite link and paste that link instead."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר להצטרף עם קישור מההודעה. במשפחה, הקישו על העתקת קישור הזמנה והדביקו את הקישור הזה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приглашение из Сообщений нельзя вставить. В Настройках нажмите «Скопировать ссылку-приглашение» и вставьте её."
          }
        }
      }
    },
    "The family list stays in the owner's Private iCloud database. After you join with the invite code, it appears under Shared on your account — not in a second Private zone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The family list stays in the owner's Private iCloud database. After you join with the invite code, it appears under Shared on your account — not in a second Private zone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימת המשפחה נשארת במסד הנתונים הפרטי של הבעלים ב-iCloud. אחרי הצטרפות עם קוד ההזמנה היא מופיעה אצלכם תחת משותף — לא באזור פרטי שני."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семейный список хранится в личной базе iCloud владельца. После входа по коду приглашения он появится в разделе «Общие» вашего аккаунта — не во второй личной зоне."
          }
        }
      }
    },
    "The family list stays in the owner's Private iCloud database. After you join with the invite link, it appears under Shared on your account — not in a second Private zone.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The family list stays in the owner's Private iCloud database. After you join with the invite link, it appears under Shared on your account — not in a second Private zone."
          }
