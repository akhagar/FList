    },
    "This name appears at the top of the list for everyone who shares it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name appears at the top of the list for everyone who shares it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם הזה מופיע בראש הרשימה אצל כל מי שמשתף אותה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это название видят все, у кого есть этот список."
          }
        }
      }
    },
    "This shared list isn't available on this iPhone yet. Join with Copy invite link first. Both phones need the same kind of build — Xcode or TestFlight.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shared list isn't available on this iPhone yet. Join with Copy invite link first. Both phones need the same kind of build — Xcode or TestFlight."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשימה המשותפת עדיין לא זמינה באייפון הזה. קודם הצטרפו עם קישור שהועתק ממשפחה. בשני האייפונים צריך אותו סוג בנייה — Xcode או TestFlight."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот общий список пока недоступен на этом iPhone. Сначала войдите по скопированной ссылке. На обоих телефонах должна быть одна и та же сборка — Xcode или TestFlight."
          }
        }
      }
    },
    "This shared list isn't available on this iPhone yet. Join with the invite code first. Both phones need the same kind of build — Xcode or TestFlight.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shared list isn't available on this iPhone yet. Join with the invite code first. Both phones need the same kind of build — Xcode or TestFlight."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשימה המשותפת עדיין לא זמינה באייפון הזה. קודם הצטרפו עם קוד ההזמנה. בשני הטלפונים צריכה להיות אותה סוג בנייה — Xcode או TestFlight."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот общий список пока недоступен на этом iPhone. Сначала войдите по коду приглашения. На обоих телефонах должна быть одна и та же сборка — Xcode или TestFlight."
          }
        }
      }
    },
    "Used when you add items, so the family can see who asked.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when you add items, so the family can see who asked."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצג כשמוסיפים פריט, כדי שהמשפחה תדע מי ביקש."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется при добавлении товаров, чтобы семья видела, кто попросил."
          }
        }
      }
    },
    "View photo": {
      "localizations": {
