    "They paste the code in FList, or scan this QR code in the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They paste the code in FList, or scan this QR code in the app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדביקים את הקוד ב-FList, או סורקים את קוד ה-QR באפליקציה."
          }
        },
        "ru": {
          "stringUnit": {
