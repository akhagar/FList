{
  "sourceLanguage": "en",
  "strings": {
    "%@ · Invited": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · הוזמן/ה"
          }
        }
      }
    },
    "%@ (you)": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (את/ה)"
          }
        }
      }
    },
    "×%lld": {
      "comment": "A label that shows the quantity of an item. The argument is the quantity of the item.",
      "isCommentAutoGenerated": true
    },
    "Add": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספה"
          }
        }
      }
    },
    "Add item": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת פריט"
          }
        }
      }
    },
    "Add milk, soap, or anything you're out of": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו חלב, סבון או כל דבר שנגמר"
          }
        }
      }
    },
    "Add person": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת אדם"
          }
        }
      }
    },
    "Add photo": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת תמונה"
          }
        }
      }
    },
    "Add to list": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספה לרשימה"
          }
        }
      }
    },
    "Added by %@": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נוסף על ידי %@"
          }
        }
      }
    },
    "Back in stock": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזר למלאי"
          }
        }
      }
    },
    "Back in stock · %@": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזר למלאי · %@"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול"
          }
        }
      }
    },
    "Checking iCloud…": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודקים את iCloud…"
          }
        }
      }
    },
    "Choose photo": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירת תמונה"
          }
        }
      }
    },
    "Couldn't share": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשתף"
          }
        }
      }
    },
    "Create family list": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת רשימה משפחתית"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקה"
          }
        }
      }
    },
    "Edit person": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עריכת אדם"
          }
        }
      }
    },
    "Family": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משפחה"
          }
        }
      }
    },
    "Family member": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בן/בת משפחה"
          }
        }
      }
    },
    "Family shortage list": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימת חוסרים משפחתית"
          }
        }
      }
    },
    "Filter": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סינון"
          }
        }
      }
    },
    "FList": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "FList"
          }
        }
      }
    },
    "Household": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משק בית"
          }
        }
      }
    },
    "iCloud is restricted on this device. You can still keep a local list.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud מוגבל במכשיר הזה. אפשר עדיין לשמור רשימה מקומית."
          }
        }
      }
    },
    "In stock": {
      "extractionState": "stale",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במלאי"
          }
        }
      }
    },
    "Invite family": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמנת המשפחה"
          }
        }
      }
    },
    "Invite the same people as your iCloud Family Sharing group. They keep their own Apple ID; this app cannot read the Family list by itself.": {
      "extractionState": "stale",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמינו את אותם אנשים כמו בקבוצת שיתוף המשפחה ב‑iCloud. לכל אחד נשאר חשבון Apple משלו; האפליקציה לא יכולה לקרוא את רשימת המשפחה בעצמה."
          }
        }
      }
    },
    "Invited": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוזמן/ה"
          }
        }
      }
    },
    "Item": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריט"
          }
        }
      }
    },
    "Items you mark as back in stock will show up here.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים שסימנתם כשחזרו למלאי יופיעו כאן."
          }
        }
      }
    },
    "Join our family shortage list in FList": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצטרפו לרשימת החוסרים המשפחתית ב‑FList"
          }
        }
      }
    },
    "Joined": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצטרף/ה"
          }
        }
      }
    },
    "Just you for now": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בינתיים רק אתם"
          }
        }
      }
    },
    "Mark as back in stock": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סימון כחזר למלאי"
          }
        }
      }
    },
    "Mark as needed": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סימון כחסר"
          }
        }
      }
    },
    "Mark it when it's back on the shelf": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמנו כשזה חוזר למדף"
          }
        }
      }
    },
    "Me": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני"
          }
        }
      }
    },
    "Member": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חבר/ה"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם"
          }
        }
      }
    },
    "Needed": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסר"
          }
        }
      }
    },
    "No restocked items yet": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין פריטים שחזרו למלאי"
          }
        }
      }
    },
    "Note (optional)": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערה (לא חובה)"
          }
        }
      }
    },
    "Nothing is missing": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא חסר כלום"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אישור"
          }
        }
      }
    },
    "One shared list of what's missing at home. Anyone in the family can add an item, then check it off when it's back in stock.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימה משותפת אחת של מה שחסר בבית. כל אחד במשפחה יכול להוסיף פריט, ואז לסמן אותו כשחזר למלאי."
          }
        }
      }
    },
    "Only the person who created the list can manage sharing.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק מי שיצר את הרשימה יכול לנהל את השיתוף."
          }
        }
      }
    },
    "Organizer": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מארגן/ת"
          }
        }
      }
    },
    "Photo": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונה"
          }
        }
      }
    },
    "Quantity: %lld": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמות: %lld"
          }
        }
      }
    },
    "Remove %@ from the family list?": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להסיר את %@ מרשימת המשפחה?"
          }
        }
      }
    },
    "Remove from list": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרה מהרשימה"
          }
        }
      }
    },
    "Remove photo": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרת תמונה"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירה"
          }
        }
      }
    },
    "Send the invite once with Messages. Whoever opens the link on their iPhone can join this list.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלחו את ההזמנה פעם אחת בהודעות. מי שיפתח את הקישור באייפון יוכל להצטרף לרשימה."
          }
        }
      }
    },
    "Share with your iCloud Family via Apple's share sheet": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתפו עם משפחת iCloud דרך גיליון השיתוף של אפל"
          }
        }
      }
    },
    "Sharing details": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרטי השיתוף"
          }
        }
      }
    },
    "Sign in to iCloud in Settings to invite people from your Family Sharing group. Apple doesn't let apps read that group automatically — you invite them once with Share.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברו ל‑iCloud בהגדרות כדי להזמין אנשים מקבוצת שיתוף המשפחה. אפל לא מאפשרת לאפליקציות לקרוא את הקבוצה אוטומטית — מזמינים פעם אחת דרך שיתוף."
          }
        }
      }
    },
    "Sign in to iCloud in Settings to share this list with family.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברו ל‑iCloud בהגדרות כדי לשתף את הרשימה עם המשפחה."
          }
        }
      }
    },
    "Something went wrong": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש"
          }
        }
      }
    },
    "Start list on this iPhone": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחלת רשימה באייפון הזה"
          }
        }
      }
    },
    "Take photo": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צילום תמונה"
          }
        }
      }
    },
    "Tap + when you run out of something.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו על + כשמשהו נגמר."
          }
        }
      }
    },
    "The invite link could not be created. Try again.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן ליצור את קישור ההזמנה. נסו שוב."
          }
        }
      }
    },
    "The shared list could not be found.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשימה המשותפת לא נמצאה."
          }
        }
      }
    },
    "Used when you add items, so the family can see who asked.": {
      "extractionState": "stale",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצג כשמוסיפים פריט, כדי שהמשפחה תדע מי ביקש."
          }
        }
      }
    },
    "What are you out of?": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה נגמר?"
          }
        }
      }
    },
    "You": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "את/ה"
          }
        }
      }
    },
    "You're not signed in to iCloud, so this list stays on this iPhone. Sign in under Settings to share it.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא מחוברים ל‑iCloud, לכן הרשימה נשארת באייפון הזה. התחברו בהגדרות כדי לשתף אותה."
          }
        }
      }
    },
    "Your name on the list": {
      "extractionState": "stale",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם שלך ברשימה"
          }
        }
      }
    },
    "New shortage item": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריט חסר חדש"
          }
        }
      }
    },
    "%@ added %@": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הוסיף/ה את %@"
          }
        }
      }
    },
    "%@ is back in stock": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ חזר למלאי"
          }
        }
      }
    }
  },
  "version": "1.1"
}
