    "You asked the family to update the list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You asked the family to update the list."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביקשת מהמשפחה לעדכן את הרשימה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы попросили семью обновить список."
          }
        }
      }
    },
    "You leave this shared list. The rest of the family keeps it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You leave this shared list. The rest of the family keeps it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תעזבו את הרשימה המשותפת. שאר המשפחה תשמור אותה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы покинете этот общий список. У остальных в семье он останется."
          }
        }
      }
    },
    "You're not signed in to iCloud, so this list stays on this iPhone. Sign in under Settings to share it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're not signed in to iCloud, so this list stays on this iPhone. Sign in under Settings to share it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא מחוברים ל‑iCloud, לכן הרשימה נשארת באייפון הזה. התחברו בהגדרות כדי לשתף אותה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не вошли в iCloud, поэтому список остаётся на этом iPhone. Войдите в Настройках, чтобы им поделиться."
          }
        }
      }
    },
    "Your items stay in your Private FamilyShortage zone. Invited people don't get a copy there — after they join, the same zone shows under Shared on their iCloud account. Use Copy invite link — a Messages invitation expires and can't be pasted.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your items stay in your Private FamilyShortage zone. Invited people don't get a copy there — after they join, the same zone shows under Shared on their iCloud account. Use Copy invite link — a Messages invitation expires and can't be pasted."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריטים שלכם נשארים באזור FamilyShortage הפרטי. מוזמנים לא מקבלים עותק שם — אחרי שהם מצטרפים, אותו אזור מופיע תחת Shared בחשבון שלהם. השתמשו בהעתקת קישור הזמנה — הזמנה מהודעות פגה ואי אפשר להדביק אותה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши товары остаются в вашей личной зоне FamilyShortage. Приглашённые не получают копию там — после входа та же зона появится у них в разделе «Общие». Используйте «Скопировать ссылку-приглашение»: приглашение из Сообщений истекает и его нельзя вставить."
          }
        }
      }
    },
    "Your items stay in your Private FamilyShortage zone. Invited people don't get a copy there — after they join, the same zone shows under Shared on their iCloud account. Use the invite code or QR — a Messages invitation expires and can't be pasted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your items stay in your Private FamilyShortage zone. Invited people don't get a copy there — after they join, the same zone shows under Shared on their iCloud account. Use the invite code or QR — a Messages invitation expires and can't be pasted."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריטים נשארים באזור FamilyShortage הפרטי שלכם. מוזמנים לא מקבלים עותק שם — אחרי שהם מצטרפים, אותו אזור מופיע אצלם תחת משותף. השתמשו בקוד ההזמנה או ב-QR — הזמנה מהודעות פגה ואי אפשר להדביק אותה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши товары остаются в вашей личной зоне FamilyShortage. Приглашённые не получают копию там — после входа та же зона появится у них в разделе «Общие». Используйте код приглашения или QR: приглашение из Сообщений истекает и его нельзя вставить."
          }
        }
      }
    },
