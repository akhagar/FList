    },
    "You're not signed in to iCloud, so this list stays on this device. Sign in under Settings to share it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're not signed in to iCloud, so this list stays on this device. Sign in under Settings to share it."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא מחוברים ל‑iCloud, לכן הרשימה נשארת במכשיר הזה. התחברו בהגדרות כדי לשתף אותה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
