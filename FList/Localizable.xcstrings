    },
    "That doesn't look like an FList invite link." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה לא נראה כמו קישור הזמנה של FList."
          }
        }
      }
    },
    "That Messages invite can't be pasted. On Family, tap Copy invite link and paste that link instead." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אי אפשר להצטרף עם קישור מההודעה. במשפחה, הקישו על העתקת קישור הזמנה והדביקו את הקישור הזה."
          }
        }
      }
    },
    "The family list stays in the owner's Private iCloud database. After you join with the invite link, it appears under Shared on your account — not in a second Private zone." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרשימה המשפחתית נשארת במסד הפרטי של מי שיצר אותה. אחרי הצטרפות עם קישור ההזמנה היא מופיעה תחת Shared בחשבון שלכם — לא כאזור Private נוסף."
          }
        }
      }
    },
    "The invite link could not be created. Try again." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן ליצור את קישור ההזמנה. נסו שוב."
          }
        }
      }
    },
    "The shared list could not be found." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרשימה המשותפת לא נמצאה."
          }
        }
      }
    },
    "This name appears at the top of the list for everyone who shares it." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השם הזה מופיע בראש הרשימה אצל כל מי שמשתף אותה."
          }
        }
      }
    },
    "This shared list isn't available on this iPhone yet. Join with Copy invite link first. Both phones need the same kind of build — Xcode or TestFlight." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרשימה המשותפת עדיין לא זמינה באייפון הזה. קודם הצטרפו עם קישור שהועתק ממשפחה. בשני האייפונים צריך אותו סוג בנייה — Xcode או TestFlight."
          }
        }
      }
    },
    "Used when you add items, so the family can see who asked." : {
      "extractionState" : "stale",
      "localizations" : {
